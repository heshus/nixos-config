# Скопируй этот файл в ~/.config/nixos-secrets/secrets.nix и заполни реальными значениями:
#   mkdir -p ~/.config/nixos-secrets
#   cp secrets.nix.example ~/.config/nixos-secrets/secrets.nix
#
# flake.nix импортирует секреты именно оттуда (абсолютным путём), а не из этой директории —
# так secrets.nix никогда не попадёт в git. Сборка требует флаг --impure.
{
  vpsHost = "vpn@ваш_секретный_ip_или_домен";
  syncthingGui = "ваш_секретный_ip:порт";
}
